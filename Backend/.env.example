# Environment
ENV=dev
DEBUG=True
APP_NAME="Solar Rooftop Management API"
APP_VERSION="0.1.0"

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8080","*"]

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solar_db
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/solar_test_db
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security & JWT
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OTP Settings
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6
DEV_MOCK_OTP="123456"

# Storage (MinIO / S3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=solar-uploads
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=False
